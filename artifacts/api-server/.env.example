# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── OpenAI (번역 기능) ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=           # 선택사항: OpenAI 호환 커스텀 엔드포인트
# OPENAI_MODEL=gpt-4o-mini   # 선택사항: 기본값 gpt-4o-mini

# ─── Admin 초기 계정 (seed 시 사용) ─────────────────────────────────────────
ADMIN_EMAIL=admin@dostac.co.kr
ADMIN_NAME=DOSTAC Admin
ADMIN_PASSWORD=dostac1234!

# ─── Product Import API ───────────────────────────────────────────────────────
IMPORT_API_KEY=your-import-api-key

# ─── 이메일 알림 (문의 수신) ─────────────────────────────────────────────────
# SMTP_HOST 가 없으면 이메일 전송이 건너뜀 (사이트 동작에는 영향 없음)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@dostac.co.kr
SMTP_PASS=your-app-password
SMTP_FROM="DOSTAC Contact" <admin@dostac.co.kr>
