FROM node:22-bookworm-slim AS builder
RUN corepack enable && corepack prepare pnpm@10.34.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY lib/ lib/
COPY artifacts/web/ artifacts/web/
COPY artifacts/admin/ artifacts/admin/
COPY attached_assets/ attached_assets/

RUN pnpm install --no-frozen-lockfile

# Build Next.js (standalone output)
RUN pnpm --filter @workspace/web run build

# Build admin SPA separately
RUN pnpm --filter @workspace/admin run build 2>/dev/null || true

# ── Next.js standalone runner ──────────────────────────────────────
FROM node:22-bookworm-slim AS web-runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/artifacts/web/.next/standalone ./
COPY --from=builder /app/artifacts/web/.next/static ./artifacts/web/.next/static
COPY --from=builder /app/artifacts/web/public ./artifacts/web/public

EXPOSE 3000
CMD ["node", "artifacts/web/server.js"]
