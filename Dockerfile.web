FROM node:22-bookworm-slim AS builder
RUN corepack enable && corepack prepare pnpm@10.34.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY lib/ lib/
COPY artifacts/web/ artifacts/web/
COPY artifacts/admin/ artifacts/admin/
COPY attached_assets/ attached_assets/

RUN pnpm install --no-frozen-lockfile

RUN cd artifacts/web && pnpm run build
RUN cd artifacts/admin && pnpm run build

FROM nginx:1.27-alpine
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/artifacts/web/dist/public /usr/share/nginx/html/web
COPY --from=builder /app/artifacts/admin/dist/public /usr/share/nginx/html/admin
