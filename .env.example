# ── API 서버 (Railway 환경변수) ──────────────────────────────────────
PORT=4000
NODE_ENV=production

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# OpenAI (번역 기능에 필요 - 필수)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# 이메일 (문의 발송용 - 선택)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="DOSTAC Contact <your@gmail.com>"
ADMIN_EMAIL=admin@dostac.co.kr

# 로그 레벨 (debug, info, warn, error)
LOG_LEVEL=info

# ── Next.js (Cloudflare Pages 환경변수) ─────────────────────────────
# GitHub Secrets에 등록 필요:
#   CLOUDFLARE_API_TOKEN  → Cloudflare 대시보드 > My Profile > API Tokens
#   CLOUDFLARE_ACCOUNT_ID → Cloudflare 대시보드 > 우측 사이드바
#   INTERNAL_API_URL      → https://[railway-project].railway.app

INTERNAL_API_URL=https://dostac-api.railway.app
NEXT_PUBLIC_SITE_URL=https://dostac.com
CF_PAGES=1
